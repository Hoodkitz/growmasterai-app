# ===========================================
# GrowMaster AI - Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# -------------------------------------------
# DATABASE
# -------------------------------------------
# MySQL connection string
# Format: mysql://username:password@host:port/database
DATABASE_URL="mysql://root:password@localhost:3306/growmaster"

# -------------------------------------------
# AI / GEMINI API
# -------------------------------------------
# Google Gemini API key for plant diagnosis
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# -------------------------------------------
# REVENUECAT (In-App Purchases)
# -------------------------------------------
# RevenueCat API key for subscription management
# Get yours at: https://app.revenuecat.com/
REVENUECAT_API_KEY="your-revenuecat-api-key-here"

# RevenueCat App-specific User ID (optional)
# Used for identifying your app in RevenueCat
REVENUECAT_APP_USER_ID=""

# -------------------------------------------
# OAUTH AUTHENTICATION
# -------------------------------------------
# Google OAuth Client ID
# Get yours at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Apple Sign In Client ID
# Get yours at: https://developer.apple.com/
APPLE_CLIENT_ID="your.apple.service.id"
APPLE_TEAM_ID="your-apple-team-id"
APPLE_KEY_ID="your-apple-key-id"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# -------------------------------------------
# SERVER CONFIGURATION
# -------------------------------------------
# Port for Express server (default: 3000)
PORT=3000

# Node environment (development | production | test)
NODE_ENV=development

# Server URL (used by mobile app to connect)
# For local development:
#   - iOS Simulator: http://localhost:3000
#   - Android Emulator: http://10.0.2.2:3000
#   - Physical device: http://<your-local-ip>:3000
# For production: https://your-api-domain.com
API_BASE_URL="http://localhost:3000"

# -------------------------------------------
# EXPO / APP CONFIGURATION
# -------------------------------------------
# Expo port (default: 8081)
EXPO_PORT=8081

# Public API URL (accessible from mobile app)
# This should match your server URL
EXPO_PUBLIC_API_URL="http://localhost:3000"

# -------------------------------------------
# JWT / SESSION
# -------------------------------------------
# Secret key for JWT token signing
# Generate a secure random string (min 32 characters)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# JWT expiration time (e.g., "7d", "30d", "1h")
JWT_EXPIRES_IN="30d"

# -------------------------------------------
# ADMIN
# -------------------------------------------
# Owner OpenID (user with this ID gets admin role)
# Set this to your Google/Apple ID or email
OWNER_OPEN_ID="your-email@example.com"

# -------------------------------------------
# FILE STORAGE
# -------------------------------------------
# Storage backend (local | s3 | cloudinary)
STORAGE_TYPE="local"

# Local storage path (if using local storage)
STORAGE_PATH="./uploads"

# AWS S3 Configuration (if using S3)
AWS_S3_BUCKET=""
AWS_S3_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Cloudinary Configuration (if using Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# -------------------------------------------
# PUSH NOTIFICATIONS
# -------------------------------------------
# Expo Push Notification token
EXPO_PUSH_TOKEN=""

# Firebase Cloud Messaging (FCM) - for Android
FCM_SERVER_KEY=""

# Apple Push Notification Service (APNS) - for iOS
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY=""

# -------------------------------------------
# ANALYTICS (Optional)
# -------------------------------------------
# Google Analytics
GA_TRACKING_ID=""

# Mixpanel
MIXPANEL_TOKEN=""

# -------------------------------------------
# EMAIL (Optional)
# -------------------------------------------
# SMTP Configuration for sending emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="GrowMaster AI <noreply@growmaster.ai>"

# -------------------------------------------
# RATE LIMITING
# -------------------------------------------
# Maximum requests per window
RATE_LIMIT_MAX=100

# Time window in minutes
RATE_LIMIT_WINDOW=15

# -------------------------------------------
# FEATURE FLAGS
# -------------------------------------------
# Enable/disable features
FEATURE_MARKETPLACE=true
FEATURE_COMMUNITY=true
FEATURE_AI_COACH=true
FEATURE_GAMIFICATION=true

# -------------------------------------------
# DEVELOPMENT / DEBUGGING
# -------------------------------------------
# Enable debug mode (shows additional logs)
DEBUG=false

# Enable React Query DevTools (web only)
ENABLE_REACT_QUERY_DEVTOOLS=true

# Enable tRPC logging
TRPC_DEBUG=false

# -------------------------------------------
# NOTES
# -------------------------------------------
# 1. Never commit .env file to git
# 2. Add .env to .gitignore
# 3. Use strong, unique values for secrets
# 4. Rotate API keys regularly
# 5. Use different values for dev/staging/prod
# 6. For production, use environment-specific secrets management
#    (e.g., AWS Secrets Manager, Vercel Env, etc.)
