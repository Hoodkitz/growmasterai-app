# ===========================================
# GrowMaster AI - Environment Variables
# ===========================================
# DEVELOPMENT CONFIGURATION

# -------------------------------------------
# DATABASE
# -------------------------------------------
DATABASE_URL="mysql://root:password@localhost:3306/growmaster"

# -------------------------------------------
# AI / GEMINI API
# -------------------------------------------
# TODO: Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
BUILT_IN_FORGE_API_URL="https://forge.manus.im/v1"
BUILT_IN_FORGE_API_KEY="placeholder-key-replace-me"

# -------------------------------------------
# REVENUECAT (In-App Purchases)
# -------------------------------------------
# SDK API Key (Google Play)
REVENUECAT_API_KEY="goog_KaRWjmufAmhheobtrxzlqQKNyjC"

# -------------------------------------------
# OAUTH AUTHENTICATION
# -------------------------------------------
# TODO: Configure in Google Cloud Console
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""

# TODO: Configure in Apple Developer Portal
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# -------------------------------------------
# SERVER CONFIGURATION
# -------------------------------------------
PORT=3000
NODE_ENV=development

# For local development:
# - iOS Simulator: http://localhost:3000
# - Android Emulator: http://10.0.2.2:3000
# - Physical device: http://<your-local-ip>:3000
API_BASE_URL="http://localhost:3000"

# -------------------------------------------
# EXPO / APP CONFIGURATION
# -------------------------------------------
EXPO_PUBLIC_API_URL="http://localhost:3000"

# -------------------------------------------
# JWT / SESSION
# -------------------------------------------
JWT_SECRET="dev-secret-change-this-in-production-min-32-chars-required"
JWT_EXPIRES_IN="30d"

# -------------------------------------------
# ADMIN
# -------------------------------------------
# Set this to your email to get admin access
OWNER_OPEN_ID=""

# -------------------------------------------
# FILE STORAGE
# -------------------------------------------
STORAGE_TYPE="local"
STORAGE_PATH="./uploads"

# -------------------------------------------
# DEVELOPMENT / DEBUGGING
# -------------------------------------------
DEBUG=true
